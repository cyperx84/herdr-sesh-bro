#!/usr/bin/env bash
# Mock herdr binary for sesh-bro tests. Emits canned JSON matching herdr 0.8.0
# socket-API shapes, and logs focus/create calls to $HERDR_MOCK_LOG so tests
# can assert what connect did.
set -euo pipefail

LOG="${HERDR_MOCK_LOG:-}"
log() { [[ -n $LOG ]] && printf '%s\n' "$*" >>"$LOG"; }

workspace_obj() {
  case "$1" in
    w1) printf '{"active_tab_id":"w1:t1","agent_status":"idle","focused":true,"label":"alpha","number":1,"pane_count":1,"tab_count":1,"workspace_id":"w1"}' ;;
    w2) printf '{"active_tab_id":"w2:t1","agent_status":"working","focused":false,"label":"beta","number":2,"pane_count":2,"tab_count":2,"workspace_id":"w2"}' ;;
    w3) printf '{"active_tab_id":"w3:t1","agent_status":"blocked","focused":false,"label":"gamma","number":3,"pane_count":1,"tab_count":1,"workspace_id":"w3"}' ;;
    *) printf 'mock-herdr: unknown workspace %s\n' "$1" >&2; exit 1 ;;
  esac
}

agent_obj() {
  case "$1" in
    "w1:p1"|alpha) printf '{"agent":"claude","agent_status":"idle","cwd":"/work/alpha","focused":true,"name":"alpha","pane_id":"w1:p1","terminal_title_stripped":"alpha shell","workspace_id":"w1"}' ;;
    "w2:p1"|beta)  printf '{"agent":"claude","agent_status":"working","cwd":"/work/beta","focused":false,"name":"beta","pane_id":"w2:p1","terminal_title_stripped":"beta build","workspace_id":"w2"}' ;;
    "w3:p1"|gamma) printf '{"agent":"claude","agent_status":"blocked","cwd":"/work/gamma","focused":false,"name":"gamma","pane_id":"w3:p1","terminal_title_stripped":"gamma stuck","workspace_id":"w3"}' ;;
    *) printf 'mock-herdr: unknown agent %s\n' "$1" >&2; exit 1 ;;
  esac
}

pane_obj() {
  case "$1" in
    "w1:p1") printf '{"agent_status":"idle","cwd":"/work/alpha","focused":true,"pane_id":"w1:p1","workspace_id":"w1"}' ;;
    "w2:p1") printf '{"agent_status":"working","cwd":"/work/beta","focused":false,"pane_id":"w2:p1","workspace_id":"w2"}' ;;
    "w2:p2") printf '{"agent_status":"working","cwd":"/work/beta","focused":false,"pane_id":"w2:p2","workspace_id":"w2"}' ;;
    "w3:p1") printf '{"agent_status":"blocked","cwd":"/work/gamma","focused":false,"pane_id":"w3:p1","workspace_id":"w3"}' ;;
    "x1:p1") printf '{"cwd":"/tmp/scratch","focused":false,"pane_id":"x1:p1","workspace_id":"x1"}' ;;
    *) printf 'mock-herdr: unknown pane %s\n' "$1" >&2; exit 1 ;;
  esac
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    workspace)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        list) printf '{"id":"cli:workspace:list","result":{"workspaces":[%s,%s,%s]}}\n' "$(workspace_obj w1)" "$(workspace_obj w2)" "$(workspace_obj w3)" ;;
        get)  printf '{"id":"cli:workspace:get","result":{"workspace":%s}}\n' "$(workspace_obj "$1")" ;;
        focus) log "focus workspace $1" ;;
        create)
          local cwd="" label=""
          while [[ $# -gt 0 ]]; do
            case "$1" in
              --cwd)  cwd="$2"; shift 2 ;;
              --label) label="$2"; shift 2 ;;
              *) shift ;;
            esac
          done
          log "create workspace cwd=$cwd label=$label"
          ;;
        *) printf 'mock-herdr: unknown workspace subcommand %s\n' "$sub" >&2; exit 1 ;;
      esac
      ;;
    agent)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        list) printf '{"id":"cli:agent:list","result":{"agents":[%s,%s,%s]}}\n' "$(agent_obj w1:p1)" "$(agent_obj w2:p1)" "$(agent_obj w3:p1)" ;;
        get)  printf '{"id":"cli:agent:get","result":{"agent":%s}}\n' "$(agent_obj "$1")" ;;
        read) printf '\033[32mMOCK-AGENT-TERM %s\033[0m\n' "$1" ;;
        focus) log "focus agent $1" ;;
        *) printf 'mock-herdr: unknown agent subcommand %s\n' "$sub" >&2; exit 1 ;;
      esac
      ;;
    pane)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        list)
          local panes="w1:p1 w2:p1 w2:p2 w3:p1 x1:p1"
          if [[ ${1:-} == "--workspace" ]]; then
            case "$2" in
              w1) panes="w1:p1" ;;
              w2) panes="w2:p1 w2:p2" ;;
              w3) panes="w3:p1" ;;
              *) panes="" ;;
            esac
          fi
          local out=""
          local p
          for p in $panes; do
            [[ -n $out ]] && out="$out,"
            out="$out$(pane_obj "$p")"
          done
          printf '{"id":"cli:pane:list","result":{"panes":[%s]}}\n' "$out"
          ;;
        read) printf '\033[33mMOCK-PANE-TERM %s\033[0m\n' "$1" ;;
        *) printf 'mock-herdr: unknown pane subcommand %s\n' "$sub" >&2; exit 1 ;;
      esac
      ;;
    plugin)
      printf 'mock-herdr: plugin not needed by tests\n' >&2
      exit 1
      ;;
    *) printf 'mock-herdr: unknown command %s\n' "$cmd" >&2; exit 1 ;;
  esac
}

main "$@"
