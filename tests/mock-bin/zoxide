#!/usr/bin/env bash
# Mock zoxide for sesh-bro tests. The dir list is read from
# $MOCK_ZOXIDE_LIST_FILE (newline-separated) so tests can include paths with
# spaces and control what the picker sees.
set -euo pipefail

case "${1:-}" in
  query)
    [[ ${2:-} == "--list" ]] || { echo "zoxide mock: expected 'query --list'" >&2; exit 1; }
    cat "${MOCK_ZOXIDE_LIST_FILE:-/dev/null}"
    ;;
  add) exit 0 ;;
  *) exit 1 ;;
esac
